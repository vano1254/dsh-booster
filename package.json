{
  "name": "dsh-booster",
  "version": "0.2.0",
  "description": "DSH Web GUI 增强套件：模块化的外观与交互优化，开关可持久化、改完即时生效。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "scripts",
    "tools",
    "vscode-extension",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
